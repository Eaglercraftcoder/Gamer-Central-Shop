
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whack-a-Mole</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #dff6e4;
      text-align: center;
      padding: 20px;
    }

    h1 {
      color: #246b45;
    }

    .game-container {
      max-width: 600px;
      margin: auto;
    }

    .stats {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
    }

    .game-board {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      max-width: 400px;
      margin: 30px auto;
    }

    .hole {
      aspect-ratio: 1;
      background: #865439;
      border: 5px solid #583820;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 50px;
      transition: transform 0.2s;
    }

    .hole:hover {
      transform: scale(1.05);
    }

    .hole.mole {
      background: #b7e4c7;
    }

    .hole.mole::after {
      content: "🐹";
      animation: pop 0.2s ease-out;
    }

    @keyframes pop {
      from { transform: scale(0); }
      to { transform: scale(1); }
    }

    button {
      padding: 12px 25px;
      margin: 8px;
      background: #2d8659;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 16px;
    }

    button:hover {
      background: #205c3d;
    }

    #message {
      color: #246b45;
    }
  </style>
</head>

<body>

  <div class="game-container">
    <h1>Whack-a-Mole!</h1>
    <p>Hit the mole before it disappears!</p>

    <div class="stats">
      <h3>Score: <span id="score">0</span></h3>
      <h3>Time: <span id="timer">30</span>s</h3>
      <h3>High Score: <span id="highScore">0</span></h3>
    </div>

    <div class="game-board">
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
      <div class="hole"></div>
    </div>

    <button id="startBtn">Start Game</button>
    <button id="restartBtn">Restart</button>

    <h2 id="message"></h2>
  </div>

  <script>
    let score = 0;
    let timeLeft = 30;
    let gameRunning = false;

    let moleInterval;
    let timerInterval;

    // Constant mole speed: 1000 milliseconds
    const moleSpeed = 1000;

    const holes = document.querySelectorAll(".hole");
    const scoreDisplay = document.getElementById("score");
    const timerDisplay = document.getElementById("timer");
    const highScoreDisplay = document.getElementById("highScore");
    const message = document.getElementById("message");

    let highScore =
      Number(localStorage.getItem("highScore")) || 0;

    highScoreDisplay.textContent = highScore;

    // Make the mole appear in a random hole.
    function showMole() {
      holes.forEach(hole => {
        hole.classList.remove("mole");
      });

      let randomIndex = Math.floor(Math.random() * holes.length);

      holes[randomIndex].classList.add("mole");
    }

    // Start the game.
    function startGame() {
      if (gameRunning) return;

      gameRunning = true;
      score = 0;
      timeLeft = 30;

      scoreDisplay.textContent = score;
      timerDisplay.textContent = timeLeft;
      message.textContent = "";

      showMole();

      // Mole moves at a constant speed.
      moleInterval = setInterval(showMole, moleSpeed);

      // Countdown timer.
      timerInterval = setInterval(() => {
        timeLeft--;
        timerDisplay.textContent = timeLeft;

        if (timeLeft <= 0) {
          endGame();
        }
      }, 1000);
    }

    // Award points when the mole is clicked.
    holes.forEach(hole => {
      hole.addEventListener("click", () => {

        if (!gameRunning) return;

        if (hole.classList.contains("mole")) {

          hole.classList.remove("mole");

          score += 10;
          scoreDisplay.textContent = score;

          // Show another mole immediately.
          showMole();
        }

      });
    });

    // End the game and save the high score.
    function endGame() {
      gameRunning = false;

      clearInterval(moleInterval);
      clearInterval(timerInterval);

      holes.forEach(hole => {
        hole.classList.remove("mole");
      });

      message.textContent =
        "Game Over! Your final score: " + score;

      if (score > highScore) {
        highScore = score;

        localStorage.setItem("highScore", highScore);

        highScoreDisplay.textContent = highScore;

        message.textContent += " NEW HIGH SCORE!";
      }
    }

    // Start button.
    document.getElementById("startBtn")
      .addEventListener("click", startGame);

    // Restart button.
    document.getElementById("restartBtn")
      .addEventListener("click", () => {

        clearInterval(moleInterval);
        clearInterval(timerInterval);

        gameRunning = false;

        holes.forEach(hole => {
          hole.classList.remove("mole");
        });

        startGame();
      });

  </script>

</body>
</html>
